generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres.
// DATABASE_URL: transaction pooler (port 6543, ?pgbouncer=true) — used by the app at runtime.
// DIRECT_URL:   session pooler (port 5432) — used only by `prisma migrate`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String              @id @default(cuid())
  email        String?             @unique
  phone        String?             @unique
  name         String
  passwordHash String?
  googleId     String?             @unique
  role         String              @default("MEMBER")
  createdAt    DateTime            @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  views        PageView[]
  logins       LoginEvent[]
  rides        TestRide[]
  applications DealerApplication[]

  @@index([role, createdAt])
}

// Permanent sign-in history. Sessions are deleted on sign-out; this is not.
// method: "password" | "google" | "signup". success=false rows are failed attempts.
model LoginEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       String
  method     String
  success    Boolean
  identifier String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([role, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

model TestRide {
  id        String    @id @default(cuid())
  name      String
  phone     String
  city      String
  model     String
  date      String?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  // Desk follow-up. status: NEW | CONTACTED | COMPLETED | CANCELLED (lib/leads.ts).
  status    String    @default("NEW")
  adminNote String?
  statusAt  DateTime?

  @@index([createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

model DealerApplication {
  id        String    @id @default(cuid())
  reference String    @unique
  name      String
  phone     String
  location  String
  model     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  // Desk follow-up. status: NEW | CONTACTED | APPROVED | REJECTED (lib/leads.ts).
  status    String    @default("NEW")
  adminNote String?
  statusAt  DateTime?

  @@index([createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  kind      String   @default("view")
  seconds   Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([userId])
  @@index([kind, createdAt])
  @@index([kind, path])
  @@index([userId, kind])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  slot      String   @id
  filename  String
  mime      String
  bytes     Bytes
  updatedAt DateTime @updatedAt
}
