# Local file database. For the live site, use a Neon Postgres URL and
# change provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# At least 32 random characters. Used to hash session cookies.
AUTH_SECRET="replace-with-32-plus-random-characters"

# Created once, on the first visit to /login, if that email does not exist yet.
ADMIN_EMAIL="admin@mriga.local"
ADMIN_PASSWORD="replace-with-a-long-password"

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# and the same path on the live domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
