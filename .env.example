# ─────────────────────────────────────────────────────────────────────────────
# MRIGA environment. Copy to .env for local dev. In production, set the same
# keys in Vercel → Project → Settings → Environment Variables (never commit .env).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: Supabase ──────────────────────────────────────────────────────
# Supabase → Project → Connect (top bar) → "ORMs" → Prisma. Copy both lines.
# Replace [YOUR-PASSWORD]. If the password has @ : / ? # or %, URL-encode it
# (e.g. @ → %40), or reset it to letters and numbers only.
#
# DATABASE_URL = Transaction pooler, port 6543. Used by the running app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL = Session pooler, port 5432. Used only by migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Sessions ─────────────────────────────────────────────────────────────────
# 32+ random characters. Use a DIFFERENT value in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-32-plus-random-characters"

# ── Admin desk ───────────────────────────────────────────────────────────────
# Created on the first visit to /admin/login. 12+ characters with a letter and a number.
# Changing it here later does nothing — run `npm run admin:password` instead.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Local: http://localhost:3000  Production: https://yourdomain.in
SITE_URL="http://localhost:3000"

# "1" only when the domain's DNS records are proxied through Cloudflare (orange cloud).
# Leave empty for DNS-only (grey cloud) or local dev.
TRUST_CLOUDFLARE=""

# ── Cloudflare Turnstile (bot check on every login, signup, and form) ──────
# Cloudflare dashboard → Turnstile → Add widget → Hostnames: your domain (+ localhost for testing)
# → Widget mode: Managed. Copy the Site Key and Secret Key here and into Vercel.
# Leave both empty to switch the check off. For local testing, Cloudflare publishes test keys
# that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Google sign-in (optional) ────────────────────────────────────────────────
# The button stays hidden until both are set. Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
